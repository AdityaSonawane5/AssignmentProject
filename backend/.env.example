# Port the Express server listens on
PORT=5000

# MongoDB connection string (MongoDB Atlas or local)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/book-manager?retryWrites=true&w=majority

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET=replace-this-with-a-long-random-secret

# How long a login session lasts (jsonwebtoken "expiresIn" format)
JWT_EXPIRES_IN=7d

# The exact URL of your deployed/local frontend — required for CORS
FRONTEND_URL=http://localhost:3000

# Set to "production" on your deployment platform
NODE_ENV=development
